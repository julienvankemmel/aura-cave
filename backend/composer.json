{
    "name": "aura-cave/backend",
    "description": "AuraCave AI - Symfony API (catalogue, panier, checkout Zero-PII)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-sodium": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "pgvector/pgvector": "^0.2.2",
        "phpstan/phpdoc-parser": "^2.4",
        "symfony/clock": "^8.1",
        "symfony/console": "^8.1",
        "symfony/doctrine-bridge": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1",
        "symfony/rate-limiter": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "^8.1"
    },
    "autoload": { "psr-4": { "App\\": "src/" } },
    "autoload-dev": { "psr-4": { "App\\Tests\\": "tests/" } },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": { "*": "dist" },
        "sort-packages": true,
        "allow-plugins": { "symfony/runtime": true },
        "platform": {
            "php": "8.5.0"
        }
    },
    "extra": { "symfony": { "allow-contrib": false, "require": "8.1.*" } },
    "scripts": {
        "lint": "phpstan analyse --memory-limit=512M",
        "test": "phpunit"
    }
}
