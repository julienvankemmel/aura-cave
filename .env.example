# Copier vers .env (make up le fait automatiquement). Ne jamais committer .env.
# Valeurs ci-dessous : placeholders de développement local uniquement.

# --- Import du jeu de données vin (Kaggle dev7halo/wine-information) ---
# Taux de conversion des prix sources (wons coréens) vers l'euro, à ajuster : défaut 1450.
# WINE_KRW_PER_EUR=1450

# --- Images produits (optionnel) ---
# Hôtes HTTPS autorisés pour attributes.image_url (politique CSP du frontend), séparés par des virgules.
# IMAGE_HOSTS=cdn.exemple.fr

# --- PostgreSQL ---
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=change-me-dev-only

# --- Backend Symfony ---
APP_SECRET=change-me-dev-only-32-chars-minimum
DATABASE_URL=postgresql://aura:change-me-dev-only@postgres:5432/aura?serverVersion=16&charset=utf8
# Clé libsodium (crypto_box) en base64 : chiffre au repos les coordonnées collectées pendant la commande.
# Générer : make keys
SODIUM_PRIVATE_KEY=

# --- Auth inter-services Agent <-> Symfony ---
INTERNAL_API_KEY=change-me-dev-only
BACKEND_URL=http://nginx:8080

# --- Sommelier (reranking gustatif des vins, côté Symfony) : Google AI Studio ---
# Clé gratuite : https://aistudio.google.com/apikey . Sans clé, les sélections sont classées localement (sans LLM).
# Modèles essayés dans l'ordre : en cas de 429 / 503 / timeout / JSON invalide, le suivant prend le relais.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=4.5

# --- LLM : openai | anthropic | groq | openrouter | ollama | mock ---
# Gratuit par défaut (groq puis openrouter en secours). Pour un rendu de production, renseignez une clé premium
# et mettez LLM_PROVIDER=openai (gpt-4o) ou anthropic : les modèles gratuits restent le secours automatique.
LLM_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- Frontend ---
AGENT_URL=http://agent:8001

# --- Ports exposés sur 127.0.0.1 ---
BACKEND_PORT=8088
AGENT_PORT=8001
FRONTEND_PORT=3100
POSTGRES_PORT=5433

# --- Agent : embeddings & LLM ---
# true = embeddings déterministes (tests/CI) ; false = modèle fastembed multilingue embarqué dans l'image
FASTEMBED_MOCK=false
OLLAMA_MODEL=llama3.1
